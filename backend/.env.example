# ─── Database Configuration (Aiven MySQL) ───
# Use the full DATABASE_URL from your Aiven console (recommended)
# Format: mysql+pymysql://user:password@host:port/database
DATABASE_URL=mysql+pymysql://avnadmin:<YOUR_AIVEN_PASSWORD>@mysql-322d9b7d-threattron-telemetry-30.j.aivencloud.com:20005/defaultdb

# Individual components (alternative — used only if DATABASE_URL is not set)
DB_USER=avnadmin
DB_PASSWORD=<YOUR_AIVEN_PASSWORD>
DB_HOST=mysql-322d9b7d-threattron-telemetry-30.j.aivencloud.com
DB_NAME=defaultdb
DB_PORT=20005

# ─── CORS Configuration ───
# Local dev:
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# With Render frontend (add your Render URL here):
# ALLOWED_ORIGINS=https://your-frontend.onrender.com,http://localhost:5173
